<mxfile host="app.diagrams.net"><diagram id="qr" name="Flujo propuesto"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" page="0" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Quejas y Reclamos – flujo propuesto por Calidad" style="text;html=1;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="-40" width="700" height="30" as="geometry"/></mxCell><mxCell id="lane_A" value="Asesor / asistente" style="swimlane;horizontal=0;startSize=44;fillColor=#F6F9FC;strokeColor=#B9C7D8;fontStyle=1;fontSize=13;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="2587" height="150" as="geometry"/></mxCell><mxCell id="lane_S" value="Sistema" style="swimlane;horizontal=0;startSize=44;fillColor=#F6F9FC;strokeColor=#B9C7D8;fontStyle=1;fontSize=13;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="170" width="2587" height="150" as="geometry"/></mxCell><mxCell id="lane_Q" value="Calidad" style="swimlane;horizontal=0;startSize=44;fillColor=#F6F9FC;strokeColor=#B9C7D8;fontStyle=1;fontSize=13;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="320" width="2587" height="270" as="geometry"/></mxCell><mxCell id="lane_R" value="Área responsable" style="swimlane;horizontal=0;startSize=44;fillColor=#F6F9FC;strokeColor=#B9C7D8;fontStyle=1;fontSize=13;collapsible=0;container=0;" vertex="1" parent="1"><mxGeometry x="20" y="590" width="2587" height="150" as="geometry"/></mxCell><UserObject id="ini" label="Inicio"><mxCell style="ellipse;html=1;fillColor=#E9F7C8;strokeColor=#6AA121;strokeWidth=3;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="167" y="77" width="36" height="36" as="geometry"/></mxCell></UserObject><UserObject id="a1" label="Ingresar N° de factura u OP" tooltip="Igual que en el flujo de Sistemas."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E3EEF9;strokeColor=#2A6BAE;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="306" y="57" width="150" height="76" as="geometry"/></mxCell></UserObject><UserObject id="s1" label="Traer ítems, OP, lote, datos de producción y antecedentes" tooltip="Además de ítems y OP, trae máquina, operador, metros y reclamos anteriores del cliente."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FDF0D5;strokeColor=#A06400;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="306" y="207" width="150" height="76" as="geometry"/></mxCell></UserObject><UserObject id="a2" label="Completar ingreso: ítems, cantidad, defecto, evidencias y etiqueta de trazabilidad" tooltip="Se agregan fecha y canal del reporte, contacto, tipo de defecto de catálogo, situación del material y foto de la etiqueta de trazabilidad."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FDF0D5;strokeColor=#A06400;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="502" y="57" width="150" height="76" as="geometry"/></mxCell></UserObject><UserObject id="s2" label="Generar reclamo RECIBIDO y notificar a Calidad" tooltip="Además avisa si el reporte está fuera del plazo de la política y notifica a Calidad."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FDF0D5;strokeColor=#A06400;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="502" y="207" width="150" height="76" as="geometry"/></mxCell></UserObject><UserObject id="q1" label="Revisar ingreso" tooltip="Igual."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E3EEF9;strokeColor=#2A6BAE;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="502" y="357" width="150" height="76" as="geometry"/></mxCell></UserObject><UserObject id="g1" label="¿Información completa?" tooltip="Igual."><mxCell style="rhombus;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2A6BAE;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="711" y="347" width="124" height="97" as="geometry"/></mxCell></UserObject><UserObject id="s3" label="Notificar al asesor con el motivo de devolución" tooltip="Igual; el motivo sale de un catálogo."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E3EEF9;strokeColor=#2A6BAE;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="698" y="207" width="150" height="76" as="geometry"/></mxCell></UserObject><UserObject id="a3" label="Corregir el ingreso en el mismo ticket" tooltip="Sistemas solo permitía cargar documentación adicional; ahora se corrige todo el ingreso."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FDF0D5;strokeColor=#A06400;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="698" y="57" width="150" height="76" as="geometry"/></mxCell></UserObject><UserObject id="g2" label="¿Procede?" tooltip="Igual."><mxCell style="rhombus;whiteSpace=wrap;html=1;fillColor=#E3EEF9;strokeColor=#2A6BAE;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="907" y="347" width="124" height="97" as="geometry"/></mxCell></UserObject><UserObject id="q2" label="Rechazar con motivo del catálogo y observación" tooltip="Igual (une "Rechazar" y "Registrar motivo")."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#E3EEF9;strokeColor=#2A6BAE;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="894" y="477" width="150" height="76" as="geometry"/></mxCell></UserObject><UserObject id="fr" label="Fin (rechazado)"><mxCell style="ellipse;html=1;fillColor=#F3B4B0;strokeColor=#A3241C;strokeWidth=4;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1147" y="497" width="36" height="36" as="geometry"/></mxCell></UserObject><UserObject id="q3" label="Categorizar, dar severidad y asignar área y fecha" tooltip="Además de queja o reclamo: severidad, área responsable y fecha compromiso."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FDF0D5;strokeColor=#A06400;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1090" y="357" width="150" height="76" as="geometry"/></mxCell></UserObject><UserObject id="g3" label="¿Requiere visita técnica?" tooltip="Nuevo."><mxCell style="rhombus;whiteSpace=wrap;html=1;fillColor=#DCF2E5;strokeColor=#1D7A4A;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1299" y="347" width="124" height="97" as="geometry"/></mxCell></UserObject><UserObject id="q4" label="Agendar y realizar visita técnica; registrar hallazgos" tooltip="Nuevo. Se notifica al asesor para coordinar con el cliente."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DCF2E5;strokeColor=#1D7A4A;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1482" y="357" width="150" height="76" as="geometry"/></mxCell></UserObject><UserObject id="r1" label="Analizar: contención, causa raíz y acciones correctivas" tooltip="Sistemas dejó abierto quién analiza ("¿y área responsable?"); ahora lo hace el área asignada, con estructura."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FDF0D5;strokeColor=#A06400;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1482" y="627" width="150" height="76" as="geometry"/></mxCell></UserObject><UserObject id="q5" label="Registrar solución al cliente" tooltip="Nuevo: tipo de solución y cantidad."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#DCF2E5;strokeColor=#1D7A4A;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1678" y="357" width="150" height="76" as="geometry"/></mxCell></UserObject><UserObject id="q6" label="Elaborar Informe de No Conformidad" tooltip="Reemplaza "Registrar documentación de cierre"; el sistema lo arma con los datos del ticket."><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=14;fillColor=#FDF0D5;strokeColor=#A06400;strokeWidth=2;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1874" y="357" width="150" height="76" as="geometry"/></mxCell>